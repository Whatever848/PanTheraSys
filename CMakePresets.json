{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc2019-debug",
      "displayName": "PanTheraSys VS2019 Debug",
      "description": "Configure the PanTheraSys desktop application with VS2019, Qt 6.2 and the existing Debug build tree.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc2019",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.2.0/msvc2019_64",
        "CMAKE_CXX_COMPILER": "D:/VS2019/Microsoft Visual Studio/2019/Community/VC/Tools/MSVC/14.29.30133/bin/Hostx64/x64/cl.exe",
        "PANTHERA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc2019-debug",
      "displayName": "Build PanTheraConsole",
      "configurePreset": "msvc2019-debug",
      "targets": [
        "PanTheraConsole"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "msvc2019-debug",
      "displayName": "Run PanTheraSys tests",
      "configurePreset": "msvc2019-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
