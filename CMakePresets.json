{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc2019-debug",
      "displayName": "PanTheraSys Qt MinGW Debug",
      "description": "Configure the PanTheraSys desktop application with the Qt 6.2 MinGW toolchain installed under D:/PanSoftware/QT.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "environment": {
        "PATH": "D:/PanSoftware/QT/Tools/mingw810_64/bin;D:/PanSoftware/QT/6.2.0/mingw81_64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "D:/PanSoftware/QT/6.2.0/mingw81_64",
        "CMAKE_CXX_COMPILER": "D:/PanSoftware/QT/Tools/mingw810_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/PanSoftware/QT/Tools/Ninja/ninja.exe",
        "PANTHERA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc2019-debug",
      "displayName": "Build PanTheraConsole",
      "configurePreset": "msvc2019-debug",
      "targets": [
        "PanTheraConsole"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "msvc2019-debug",
      "displayName": "Run PanTheraSys tests",
      "configurePreset": "msvc2019-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
