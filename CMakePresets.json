{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-vcpkg-debug",
      "displayName": "PanTheraConsole MinGW vcpkg Debug",
      "description": "Configure PanTheraConsole with Qt 6.2, MinGW, and vcpkg.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/mingw_vcpkg",
      "environment": {
        "PATH": "D:/PanSoftware/QT/6.2.0/mingw81_64/bin;D:/PanSoftware/QT/Tools/mingw810_64/bin;D:/PanSoftware/vcpkg/installed/x64-mingw-dynamic/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "D:/PanSoftware/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_HOST_TRIPLET": "x64-mingw-dynamic",
        "CMAKE_PREFIX_PATH": "D:/PanSoftware/QT/6.2.0/mingw81_64",
        "Qt6_DIR": "D:/PanSoftware/QT/6.2.0/mingw81_64/lib/cmake/Qt6",
        "CMAKE_C_COMPILER": "D:/PanSoftware/QT/Tools/mingw810_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/PanSoftware/QT/Tools/mingw810_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/PanSoftware/QT/Tools/mingw810_64/bin/mingw32-make.exe",
        "PANTHERA_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-vcpkg-debug",
      "displayName": "PanTheraConsole",
      "configurePreset": "mingw-vcpkg-debug",
      "jobs": 8,
      "targets": [
        "PanTheraConsole"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "mingw-vcpkg-debug",
      "displayName": "Run PanTheraSys tests",
      "configurePreset": "mingw-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
